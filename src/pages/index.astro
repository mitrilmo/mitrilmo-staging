---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Start">
  <h1>mitrilmo Staging, Spike AP0.7</h1>
  <p>Platzhalterseite zum Testen von GitHub Pages. Kein echter Inhalt.</p>
  <ul>
    <li>BASE_URL: <code>{import.meta.env.BASE_URL}</code></li>
    <li>Hash-Weiterleitung testen: <a href={`${base}/#impressum`}>/#impressum</a></li>
  </ul>
  <script is:inline define:vars={{ base }}>
    var map = { '#impressum': '/impressum', '#datenschutz': '/datenschutz', '#touren': '/touren' };
    if (map[location.hash]) location.replace(base + map[location.hash]);
  </script>
</Base>
