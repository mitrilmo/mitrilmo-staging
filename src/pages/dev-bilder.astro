---
// ENTWICKLUNGSSEITE, nur Staging. Zeigt die Bildpipeline mit den Beispieleinträgen.
// Dateien dev-*.html dürfen nie live gehen (check:dist bricht beim Live-Build ab).
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ContentImage from '../components/ContentImage.astro';

const tours = await getCollection('tours');
const videos = (await getCollection('videos')).filter((v) => v.data.thumbnail);
---
<Base title="Bilder-Test, mitrilmo Staging" description="Entwicklungsseite zur Bildpipeline, nur im Staging vorhanden.">
  <section class="max-w-5xl mx-auto px-4 py-10">
    <h1 class="text-2xl font-black text-stone-50">Bilder-Test (nur Staging)</h1>
    <p class="mt-2 text-sm text-stone-400">Das erste Bild lädt sofort (priority), alle weiteren erst beim Scrollen.</p>
    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      {tours.map((t, i) => (
        <figure>
          <ContentImage image={t.data.image} alt={t.data.imageAlt} priority={i === 0} class="w-full h-auto rounded-xl" />
          <figcaption class="mt-2 text-sm text-stone-300">{t.data.title}</figcaption>
        </figure>
      ))}
      {videos.map((v) => (
        <figure>
          <ContentImage image={v.data.thumbnail} alt={`Vorschaubild: ${v.data.title}`} class="w-full h-auto rounded-xl" />
          <figcaption class="mt-2 text-sm text-stone-300">Video: {v.data.title}</figcaption>
        </figure>
      ))}
    </div>
  </section>
</Base>
