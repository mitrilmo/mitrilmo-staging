---
// Kopfband der Unterseiten im Jahreszeiten-Look der Startseite (Himmelsverlauf und Akzentfarbe aus html[data-season]).
// Inhalt kommt über den Slot, width wie der Textbereich der Seite darunter.
const { width = 'max-w-4xl' } = Astro.props;
---
<section class="sky border-b border-white/5">
  <div class={`${width} mx-auto px-4 py-10`}>
    <slot />
  </div>
</section>
